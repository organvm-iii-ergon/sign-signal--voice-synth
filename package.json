{
  "name": "sign-signal--voice-synth",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:voice-bridge\"",
    "dev:web": "npm run dev -w @sign-signal/web",
    "dev:api": "npm run dev -w @sign-signal/api",
    "dev:voice-bridge": "npm run dev -w @sign-signal/voice-bridge",
    "build": "npm run build -w @sign-signal/web && npm run build -w @sign-signal/api",
    "test": "npm run test -w @sign-signal/web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}